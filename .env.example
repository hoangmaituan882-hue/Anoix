# Frontend configuration
VITE_CLOUDBASE_ENV_ID=
VITE_API_BASE=

# Backend server configuration (optional CloudBase PG backend)
CLOUDBASE_ENV_ID=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Local Express. Default 8080; Vite /api proxy defaults to 3001 — pick one to match.
# PORT=3001

# TMDB scrape proxy (server-only, never VITE_*)
TMDB_API_KEY=
# Optional if api.themoviedb.org is unreachable from the host:
# TMDB_API_BASE_URL=https://api.themoviedb.org/3
# TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Bangumi (bgm.tv) scrape proxy — mainland-reachable mirror, no key needed
# BANGUMI_API_BASE_URL=https://bgmapi.anibt.net
# BANGUMI_IMAGE_BASE_URL=https://bgmimg.anibt.net
